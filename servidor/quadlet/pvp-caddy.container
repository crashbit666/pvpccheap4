# Caddy de pvpccheap, darrere del Caddy d'entrada del servidor (caddy/Caddyfile).
[Unit]
Description=Caddy de pvpccheap (darrere del Caddy d'entrada)
Wants=pvp-backend.service
After=pvp-backend.service

[Container]
Image=docker.io/library/caddy:2.11.7-alpine@sha256:eb4d35b7452d1ab6171fbdbe8d9275b2301dad6dad92115d91e19fb9b24d510f
ContainerName=pvp-caddy
Network=pvp-lab.network
EnvironmentFile=%h/pvpccheap4/servidor/.env.d/caddy.env
Volume=%h/pvpccheap4/servidor/caddy:/etc/caddy:ro
Volume=pvp-caddydata.volume:/data
Volume=pvp-caddyconfig.volume:/config
Volume=/srv/webedge/pvpccheap:/srv/webedge
Exec=caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
NoNewPrivileges=true
DropCapability=all
# Encara que no escolti cap port: el binari porta file capabilities
# (cap_net_bind_service) i, sense, l'execve falla amb «operation not permitted».
AddCapability=NET_BIND_SERVICE
ReadOnly=true
Tmpfs=/tmp
PidsLimit=128
PodmanArgs=--memory=128m --cpus=0.5 --oom-score-adj=400
HealthCmd=wget -q -O /dev/null -T 3 http://127.0.0.1:2019/config/
HealthInterval=15s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=20s

[Service]
Restart=always

[Install]
WantedBy=default.target
