# Database
DB_PASSWORD=your-secure-database-password

# JWT Secret (genera un amb: openssl rand -hex 32)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Clau que xifra les credencials dels proveïdors (Meross) a la base de dades:
# 64 caràcters hex, genera-la amb: openssl rand -hex 32
# Guarda'n una còpia fora del servidor: si es perd, cal tornar a afegir Meross.
CREDENTIALS_KEY=

# Optional: contact address shown on /privacitat, /condicions and /esborrar-compte
# CONTACT_EMAIL=

# Optional: rules written in plain words (paid plan), with the Claude API
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: account emails (verify the address, reset the password) via Brevo.
# MAIL_FROM must be a sender verified in Brevo; PUBLIC_URL is where the links point.
# BREVO_API_KEY=
# MAIL_FROM=no-reply@example.com
# MAIL_FROM_NAME=PVPC Cheap
# PUBLIC_URL=https://pvpccheap.crashbit.cat

# Optional: check Google Play purchases of the paid plan. The Play Console
# service account's JSON key, in base64 on one line (base64 -w0 key.json).
# GOOGLE_PLAY_SERVICE_ACCOUNT=
# Secret in the Pub/Sub push URL of the real-time notifications
# (.../api/billing/google/notifications?token=<secret>); openssl rand -hex 24
# GOOGLE_PLAY_RTDN_SECRET=

# Optional: let Home Assistant URLs point to private addresses (only when the
# backend runs inside the same home network)
# HA_ALLOW_PRIVATE_URLS=1

# Optional: ESIOS API token for price fetching
# ESIOS_TOKEN=your-esios-api-token
